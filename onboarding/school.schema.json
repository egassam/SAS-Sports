{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sas-sports.local/onboarding/school.schema.json",
  "title": "SAS Sports candidate school",
  "type": "object",
  "required": ["schema_version", "status", "school", "publisher", "sponsored_sports", "sources", "certification"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["candidate", "ready", "certified"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "school": {
      "type": "object",
      "required": ["id", "name", "athletics_url"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "name": {"type": "string", "minLength": 2},
        "short_name": {"type": "string"},
        "conference": {"type": "string"},
        "state": {"type": "string"},
        "athletics_url": {"type": "string", "pattern": "^https://"}
      },
      "additionalProperties": true
    },
    "publisher": {"enum": ["SIDEARM", "WMT", "PRESTO", "CUSTOM"]},
    "sponsored_sports": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["schedule_urls", "roster_urls"],
        "properties": {
          "schedule_urls": {"type": "array", "items": {"type": "string", "pattern": "^https://"}},
          "roster_urls": {"type": "array", "items": {"type": "string", "pattern": "^https://"}}
        }
      }
    },
    "certification": {
      "type": "object",
      "required": ["release_tests", "deep_live", "isolation", "mobile_switching", "all_existing_schools"],
      "properties": {
        "release_tests": {"type": "boolean"},
        "deep_live": {"type": "boolean"},
        "isolation": {"type": "boolean"},
        "mobile_switching": {"type": "boolean"},
        "all_existing_schools": {"type": "boolean"}
      }
    }
  }
}
