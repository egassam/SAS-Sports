{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sas-sports",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-05",
  "ai": {
    "binding": "AI"
  },
  // Verified finished events' highlights, 30 days (see /live/highlights).
  "kv_namespaces": [
    { "binding": "HIGHLIGHTS", "id": "38280ef8508844459bbe14735e825d7a" }
  ],
  // School-entered live scores (scorer app /score, TV scoreboard /scoreboard).
  // Not a Durable Object: those turn off branch previews for the whole Worker.
  "d1_databases": [
    { "binding": "SCORE_DB", "database_name": "sas-sports-live-scoring", "database_id": "47c6e939-fa7e-40fe-8471-4c0aad836eca" }
  ],
  // No scheduled jobs. Kept explicit: omitting "triggers" leaves a previously
  // deployed Cron Trigger in place (the reverted #87 added one).
  "triggers": {
    "crons": []
  },
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/schools*", "/live/*", "/api/*", "/web"]
  }
}
