{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sas-sports",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-05",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/schools*", "/live/*", "/api/*", "/web"]
  }
}
