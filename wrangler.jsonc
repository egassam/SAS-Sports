{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sas-sports",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-05",
  "ai": {
    "binding": "AI"
  },
  // Stored feeds shared by every Cloudflare location (src/feed-store.mjs).
  "kv_namespaces": [
    { "binding": "FEEDS", "id": "44e354a55a1c43ce8013e40eb2cc9a75" }
  ],
  // Every minute, rebuild the viewed feeds whose stored copy is due.
  "triggers": {
    "crons": ["* * * * *"]
  },
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/schools*", "/live/*", "/api/*", "/web"]
  }
}
